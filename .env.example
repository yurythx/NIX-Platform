# Copy this file to .env and fill in real values.
# Never commit a real .env file — secrets belong out of the codebase (§57/§61).

# --- Application ---
APP_ENV=development
APP_NAME=nix-platform
APP_LOG_LEVEL=info
LOG_FORMAT=json

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nix
DB_USER=nix
DB_PASSWORD=change-me
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_CONNECT_TIMEOUT=5s

# --- RabbitMQ ---
RABBITMQ_URL=amqp://nix:nix_password@rabbitmq:5672/nix
RABBITMQ_MAX_RETRIES=3
RABBITMQ_PREFETCH_COUNT=10
# Credentials used by the rabbitmq container itself (docker-compose.yml)
RABBITMQ_DEFAULT_USER=nix
RABBITMQ_DEFAULT_PASS=nix_password
RABBITMQ_DEFAULT_VHOST=nix

# --- Keycloak (existing external instance — never created by this project) ---
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/nix
KEYCLOAK_REALM=nix
KEYCLOAK_CLIENT_ID=nix-platform-api
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_AUDIENCE=nix-platform-api

# --- Frontend OIDC client (confidential client, used by NextAuth) ---
KEYCLOAK_FRONTEND_CLIENT_ID=nix-platform-web
KEYCLOAK_FRONTEND_CLIENT_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-byte-value

# --- Public URLs ---
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
WEBSOCKET_PUBLIC_URL=ws://localhost:8000/ws

# --- Jobs ---
JOB_TIMEOUT=5m

# --- Worker metrics/health listener (not business traffic) ---
WORKER_METRICS_HOST=0.0.0.0
WORKER_METRICS_PORT=9100

# --- Pagination ---
MAX_PAGE_SIZE=100

# --- Observability (optional; tracing is a no-op if unset) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Integrations ---
DIARIO_OFICIAL_BASE_URL=
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3

# --- Frontend build-time public config (never put secrets in NEXT_PUBLIC_*) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
