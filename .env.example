# Copie este arquivo para .env e preencha com valores reais.
# Nunca faça commit de um .env real — segredos ficam fora do código-fonte (§57/§61).
#
# Gestão de segredos: qualquer variável marcada como "segredo" abaixo também
# aceita a variante "<NOME>_FILE" apontando para um arquivo — se definida, o
# conteúdo do arquivo (sem espaços/quebras de linha nas pontas) é usado no
# lugar do valor direto da env var. É assim que Docker/Kubernetes Secrets,
# Vault Agent Sidecar e AWS Secrets Manager (via CSI driver) entregam
# segredos rotacionados sem precisar de código específico por provedor. Ex.:
# DB_PASSWORD_FILE=/run/secrets/db_password

# --- Aplicação ---
APP_ENV=development
APP_NAME=nix-platform
APP_LOG_LEVEL=info
LOG_FORMAT=json

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nix
DB_USER=nix
DB_PASSWORD=change-me
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_CONNECT_TIMEOUT=5s

# --- PostgreSQL dedicado ao SonarQube (Fase 5) — nunca o mesmo banco da
# aplicação, ver comentário em docker-compose.yml. Lido só pelo próprio
# docker-compose, não pelo backend Go. ---
SONARQUBE_DB_PASSWORD=change-me

# --- RabbitMQ ---
RABBITMQ_URL=amqp://nix:nix_password@rabbitmq:5672/nix
RABBITMQ_MAX_RETRIES=3
RABBITMQ_PREFETCH_COUNT=10
# Credenciais usadas pelo próprio container do rabbitmq (docker-compose.yml)
RABBITMQ_DEFAULT_USER=nix
RABBITMQ_DEFAULT_PASS=nix_password
RABBITMQ_DEFAULT_VHOST=nix

# --- Keycloak (instância externa já existente — nunca criada por este projeto) ---
KEYCLOAK_ISSUER_URL=https://keycloak.example.com/realms/nix
KEYCLOAK_REALM=nix
KEYCLOAK_CLIENT_ID=nix-platform-api
# KEYCLOAK_CLIENT_SECRET: reservada para uso futuro (chamadas de
# introspection/service-account do backend, ver README's "Configuração do
# Keycloak") — NENHUM código hoje lê esta variável. O backend valida
# tokens localmente via JWKS (bearer-only, nunca troca código OAuth
# sozinho), então pode ficar vazia sem quebrar nada.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_AUDIENCE=nix-platform-api

# --- Cliente OIDC do frontend (confidential client, usado pelo NextAuth) ---
KEYCLOAK_FRONTEND_CLIENT_ID=nix-platform-web
KEYCLOAK_FRONTEND_CLIENT_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-random-32-byte-value

# --- Login local (ADICIONAL ao Keycloak, nunca substituto — usuários com
# password_hash setado na tabela `users` podem logar via
# POST /api/v1/auth/login sem depender do Keycloak estar no ar. Útil para
# o primeiro acesso administrativo e para ambientes de teste/demo).
# Tokens locais são assinados RS256 com um par de chaves PRÓPRIO deste
# subsistema — nunca compartilhado com o Keycloak/SSO nem com nenhum
# outro segredo (ver docs/adr/003-local-auth-rsa-hardening.md). ---
LOCAL_AUTH_ENABLED=true
# Conteúdo PEM (PKCS1 ou PKCS8) da chave privada RSA — use a variante
# _FILE (recomendada, já que PEM é multi-linha). Gere a chave com:
#   openssl genrsa -out ./secrets/local_auth_private_key.pem 2048
# docker-compose.yml monta ./secrets (fora do controle de versão) como
# /run/secrets, somente leitura, dentro de backend-api e backend-worker —
# o caminho abaixo é o caminho DENTRO do container, não do host.
LOCAL_AUTH_PRIVATE_KEY_FILE=/run/secrets/local_auth_private_key.pem
LOCAL_AUTH_TOKEN_TTL=1h

# --- URLs públicas ---
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
WEBSOCKET_PUBLIC_URL=ws://localhost:8000/ws

# --- Jobs ---
JOB_TIMEOUT=5m

# --- Listener de métricas/health do worker (não é tráfego de negócio) ---
WORKER_METRICS_HOST=0.0.0.0
WORKER_METRICS_PORT=9100

# --- Paginação ---
MAX_PAGE_SIZE=100

# --- Observabilidade (opcional; tracing vira no-op se não configurado) ---
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Integrações ---
# DIARIO_OFICIAL_BASE_URL: ao contrário de SCANNING_TRIVY_SERVICE_URL/
# SonarQube (vazios até um operador apontar pro PRÓPRIO servidor), esta
# já vem com um default de verdade quando deixada vazia/comentada — o
# DJEN (Diário de Justiça Eletrônico Nacional, mantido pelo CNJ,
# comunicaapi.pje.jus.br), um serviço público único, sem instância
# própria por operador (ver DefaultDiarioOficialBaseURL em
# internal/platform/config/config.go). Só preencha aqui se quiser
# apontar pra outro provedor (ex.: um endpoint de teste). A feature flag
# diario_oficial_scraping_enabled (painel Configuração > Feature flags,
# habilitada por padrão) é o desligamento de emergência real — deixar
# esta variável vazia NÃO desativa a integração, só volta pro default.
DIARIO_OFICIAL_BASE_URL=
DIARIO_OFICIAL_TIMEOUT=10s

# --- Scanning (SecOps Orchestrator — docs/roadmap-secops-orchestrator.md) ---
# TrivyScanner/SemgrepScanner/SonarScanner clonam o alvo (uma URL git
# https://) via git e escaneiam com trivy/semgrep/sonar-scanner — os
# binários só precisam existir na imagem do worker (ver
# backend/Dockerfile.worker), nunca na do backend-api.
# SCANNING_TRIVY_PATH só é usado pelo caminho standalone (cmd/secscan,
# CLI — nunca fala HTTP com nada). SCANNING_TRIVY_SERVICE_URL é o
# caminho de produção (via worker): aponta pro sidecar containerizado
# (docker-compose.yml, serviço trivy-scanner) — vazio reporta o scanner
# "trivy" como indisponível em vez de derrubar o worker. Vazio ao rodar
# `docker compose up` normalmente NÃO acontece — o compose já injeta
# http://trivy-scanner:8080 (ver docker-compose.yml); só fica vazio se
# você estiver rodando o backend fora de Docker.
SCANNING_TRIVY_PATH=trivy
SCANNING_TRIVY_SERVICE_URL=
# GitleaksScanner/SyftScanner/SemgrepScanner seguem exatamente o mesmo
# padrão — sidecar containerizado próprio (docker-compose.yml, serviços
# gitleaks-scanner/syft-scanner/semgrep-scanner),
# SCANNING_GITLEAKS_PATH/SCANNING_SYFT_PATH/SCANNING_SEMGREP_PATH só
# usados pelo caminho standalone.
SCANNING_GITLEAKS_PATH=gitleaks
SCANNING_GITLEAKS_SERVICE_URL=
SCANNING_SYFT_PATH=syft
SCANNING_SYFT_SERVICE_URL=
# SCANNING_WORKSPACE_DIR precisa ser o mesmo caminho montado como volume
# compartilhado com os sidecars (trivy-scanner, gitleaks-scanner,
# syft-scanner, semgrep-scanner — docker-compose.yml,
# scanning_workspace:/workspace) — vazio usa o diretório temporário
# padrão do SO (comportamento de antes da containerização, correto pra
# rodar fora de Docker).
SCANNING_WORKSPACE_DIR=
SCANNING_SEMGREP_PATH=semgrep
SCANNING_SEMGREP_SERVICE_URL=
# Vazio usa o default (infrastructure.DefaultSemgrepConfig, "p/owasp-top-ten").
SCANNING_SEMGREP_CONFIG=
SCANNING_GIT_CLONE_TIMEOUT=3m
# Filtro de ruído por caminho (Fase 13) — lista separada por vírgula de
# padrões (sem "*": substring match contra o caminho inteiro, ex.:
# "/tests/"; com "*": glob contra só o nome do arquivo, ex.: "*_test.go").
# Vazio usa o default embutido (application.defaultNoiseFilterPatterns).
# Só tem efeito com a feature flag scanning_noise_filter_enabled ligada
# (Configuração > Feature flags na UI) — desligada por padrão: um achado
# de segredo real dentro de um arquivo de teste nunca deveria sumir
# sozinho.
SCANNING_NOISE_FILTER_PATTERNS=
# SonarScanner (Fase 5) — vazio, como SCANNING_TRIVY_SERVICE_URL acima
# (DIARIO_OFICIAL_BASE_URL não segue mais este padrão, ver acima), faz o
# scanner reportar indisponível em vez de derrubar o worker; use
# http://sonarqube:9000 pra apontar pro serviço `sonarqube` deste próprio
# docker-compose.yml. O token é gerado na UI do SonarQube (Administration
# > Security > Users > Tokens) depois do primeiro login — suporta o
# padrão "_FILE" (ver loader.secret em internal/platform/config/config.go).
# SCANNING_SONAR_SCANNER_SERVICE_URL segue o mesmo padrão de
# SCANNING_TRIVY_SERVICE_URL (§ Containerização) — sidecar containerizado
# próprio (docker-compose.yml, serviço sonar-scanner-cli — nome completo
# de propósito, pra nunca ser confundido com o serviço `sonarqube`
# alguns parágrafos abaixo, que é o SERVIDOR, não o CLI). Vazio ao rodar
# `docker compose up` normalmente NÃO acontece — o compose já injeta
# http://sonar-scanner-cli:8080. Este scanner nunca teve um caminho de
# binário local (ao contrário de trivy/gitleaks/semgrep/syft) — sempre
# exigiu servidor+credenciais, nunca funcionou "local" de qualquer forma.
SCANNING_SONAR_SCANNER_SERVICE_URL=
SCANNING_SONARQUBE_URL=
SCANNING_SONARQUBE_TOKEN=
SCANNING_SONARQUBE_ANALYSIS_TIMEOUT=5m
# SCANNING_SONARQUBE_PUBLIC_URL: diferente de SCANNING_SONARQUBE_URL
# acima (endereço INTERNO que o backend usa) — este é o endereço que o
# NAVEGADOR do usuário consegue abrir, só pra montar o link "abrir no
# SonarQube" de um achado na UI. Vazio por padrão simplesmente omite
# esse link. Em docker-compose.dev.yml (SonarQube publicado em
# localhost:9001), o valor certo é http://localhost:9001.
SCANNING_SONARQUBE_PUBLIC_URL=
# ZapScanner (Fase 6) — o scanner que ATACA de verdade, não só lê. Vazia
# por padrão, SCANNING_ZAP_ALLOWED_HOSTS RECUSA TODO ALVO até um host de
# staging/homologação ser explicitamente listado aqui (nunca um host de
# produção — regra inegociável, ver docs/roadmap-secops-orchestrator.md).
# SCANNING_ZAP_API_KEY também é obrigatória pro próprio serviço `zap`
# subir (ver docker-compose.yml) — gere uma string aleatória qualquer.
SCANNING_ZAP_URL=
SCANNING_ZAP_API_KEY=
SCANNING_ZAP_ALLOWED_HOSTS=
SCANNING_ZAP_SCAN_TIMEOUT=30m

# --- Config pública do frontend, definida em build-time (nunca coloque
# segredos em NEXT_PUBLIC_*) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- Somente server-side do frontend: onde o servidor Next.js alcança a
# API Go de dentro da rede Docker (nunca exposto ao navegador) ---
BACKEND_INTERNAL_URL=http://backend-api:8000
