# syntax=docker/dockerfile:1

# Sidecar do Gitleaks (ver cmd/gitleaks-sidecar/main.go e
# docs/roadmap-secops-orchestrator.md, seção "Containerização") — mesmo
# padrão do Dockerfile.trivy-sidecar: cada scanner isolado no seu próprio
# container, com um servidor HTTP fino na frente, em vez de compartilhar a
# imagem do backend-worker ou montar o socket do Docker.

# ---- builder ----
FROM golang:1.27-alpine AS builder
WORKDIR /src

RUN apk add --no-cache ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/gitleaks-sidecar ./cmd/gitleaks-sidecar

# ---- runtime ----
FROM alpine:3.24 AS runtime

# Binário oficial + verificação de checksum — mesmo padrão de
# Dockerfile.trivy-sidecar.
ARG GITLEAKS_VERSION=8.30.1
RUN apk add --no-cache ca-certificates curl && \
    ARCH="$(uname -m)" && \
    case "$ARCH" in \
        x86_64) GITLEAKS_ARCH="x64" ;; \
        aarch64) GITLEAKS_ARCH="arm64" ;; \
        *) echo "unsupported architecture for gitleaks: $ARCH" >&2; exit 1 ;; \
    esac && \
    cd /tmp && \
    curl -fsSLO "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz" && \
    curl -fsSLO "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_checksums.txt" && \
    grep "gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz" gitleaks_${GITLEAKS_VERSION}_checksums.txt | sha256sum -c - && \
    tar -xzf "gitleaks_${GITLEAKS_VERSION}_linux_${GITLEAKS_ARCH}.tar.gz" gitleaks && \
    mv gitleaks /usr/local/bin/gitleaks && \
    chmod +x /usr/local/bin/gitleaks && \
    rm -f /tmp/gitleaks_${GITLEAKS_VERSION}_* && \
    apk del curl

# UID/GID FIXOS (10001) — o MESMO valor que Dockerfile.worker e
# Dockerfile.trivy-sidecar usam, pelo mesmo motivo (ver o comentário
# equivalente em Dockerfile.trivy-sidecar): qualquer container pode ser o
# primeiro a montar o volume nomeado scanning_workspace ainda vazio, e é
# esse primeiro mount que decide a ownership inicial dele.
RUN addgroup -g 10001 -S nix && adduser -u 10001 -S nix -G nix && \
    mkdir -p /workspace && chown nix:nix /workspace
USER nix
WORKDIR /app
COPY --from=builder --chown=nix:nix /out/gitleaks-sidecar ./gitleaks-sidecar

ENTRYPOINT ["./gitleaks-sidecar"]
