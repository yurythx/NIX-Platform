# syntax=docker/dockerfile:1

# ---- builder ----
FROM golang:1.27-alpine AS builder
WORKDIR /src

RUN apk add --no-cache ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

# SonarScanner (Fase 5 — SonarQube) é distribuído como um JAR Java
# portável, mas a imagem oficial da SonarSource é baseada em Amazon Linux
# (glibc) — copiar os binários nativos dela pra cima de um runtime Alpine
# (musl) quebraria. Em vez disso, este estágio só serve pra extrair
# lib/bin/conf (JAR + script de shell, nenhum binário nativo) da imagem
# oficial pinada por tag; o runtime final instala sua PRÓPRIA JRE nativa
# do Alpine (musl) pra rodar esse JAR — verificado que a combinação
# funciona (ver docs/roadmap-secops-orchestrator.md, Fase 5).
FROM sonarsource/sonar-scanner-cli:12.1.0.3233_8.0.1 AS sonar-scanner-cli

# ---- runtime ----
FROM alpine:3.20 AS runtime

# git continua precisando estar na imagem do worker — TrivyScanner.Execute/
# GitleaksScanner.Execute/SemgrepScanner.Execute (o caminho HTTP, produção)
# clonam o alvo aqui e só depois mandam o PATH pro sidecar correspondente
# (ver cmd/trivy-sidecar, cmd/gitleaks-sidecar, cmd/semgrep-sidecar); os
# binários `trivy`/`gitleaks`/`semgrep` em si SAÍRAM desta imagem —
# decisão do usuário de isolar cada scanner no próprio container, como o
# GitGuard faz (ver docs/roadmap-secops-orchestrator.md, seção
# "Containerização"). O checksum do binário trivy e a instalação via pip
# do semgrep continuam verificados — só que agora nos Dockerfiles dos
# sidecars, não aqui.
RUN apk add --no-cache ca-certificates git

# SonarScanner (Fase 5 — qualidade de código/bugs via um servidor
# SonarQube self-hosted, ver docker-compose.yml) precisa do sonar-scanner
# CLI + uma JRE — os dois só na imagem do worker. openjdk21-jre-headless
# é a JRE nativa musl do Alpine (não a glibc empacotada na imagem oficial
# do estágio sonar-scanner-cli acima); só os arquivos portáveis dessa
# imagem (JAR + script de shell) são copiados.
RUN apk add --no-cache openjdk21-jre-headless
COPY --from=sonar-scanner-cli /opt/sonar-scanner /opt/sonar-scanner
RUN ln -s /opt/sonar-scanner/bin/sonar-scanner /usr/local/bin/sonar-scanner

# UID/GID FIXOS (10001), não o que "adduser -S" alocaria implicitamente
# (o próximo UID de sistema livre — não garantido igual entre duas
# imagens construídas separadamente): TrivyScanner.Execute clona pro
# volume compartilhado scanning_workspace (docker-compose.yml, montado
# em /workspace aqui E na imagem do sidecar trivy-scanner,
# Dockerfile.trivy-sidecar) — os dois processos escrevendo/lendo o MESMO
# caminho precisam do MESMO UID dono, senão o sidecar (que só lê) até
# funcionaria com permissão "outros" liberada, mas o worker (que
# ESCREVE) precisa mesmo ser dono. mkdir+chown aqui, ANTES do volume ser
# montado: Docker copia a ownership/conteúdo que já existe nesse caminho
# dentro da imagem pro volume nomeado vazio na primeira vez que ele é
# criado — sem isso, um volume nomeado novo nasce root:root, e o
# processo do worker (que roda como "nix", não root) não conseguiria
# escrever nele.
RUN addgroup -g 10001 -S nix && adduser -u 10001 -S nix -G nix && \
    mkdir -p /workspace && chown nix:nix /workspace

USER nix
WORKDIR /app
COPY --from=builder --chown=nix:nix /out/worker ./worker

ENTRYPOINT ["./worker"]
