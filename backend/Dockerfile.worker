# syntax=docker/dockerfile:1

# ---- builder ----
FROM golang:1.27-alpine AS builder
WORKDIR /src

RUN apk add --no-cache ca-certificates

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

# ---- runtime ----
FROM alpine:3.20 AS runtime

# TrivyScanner (internal/modules/scanning/infrastructure) precisa dos
# binários git (clonar o alvo) e trivy (escanear) dentro da imagem do
# worker — é o único lugar que os chama, o backend-api nunca precisa
# deles. O tarball do trivy é baixado e verificado contra o checksums.txt
# publicado pelo próprio projeto (assinado por release, não um valor fixo
# neste Dockerfile) antes de ser instalado — mesmo princípio de
# integridade de supply chain que este roadmap de segurança pede das
# ferramentas que orquestra (A08:2021).
ARG TRIVY_VERSION=0.74.0
RUN apk add --no-cache ca-certificates git curl && \
    ARCH="$(uname -m)" && \
    case "$ARCH" in \
        x86_64) TRIVY_ARCH="64bit" ;; \
        aarch64) TRIVY_ARCH="ARM64" ;; \
        *) echo "unsupported architecture for trivy: $ARCH" >&2; exit 1 ;; \
    esac && \
    cd /tmp && \
    curl -fsSLO "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-${TRIVY_ARCH}.tar.gz" && \
    curl -fsSLO "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_checksums.txt" && \
    grep "trivy_${TRIVY_VERSION}_Linux-${TRIVY_ARCH}.tar.gz" trivy_${TRIVY_VERSION}_checksums.txt | sha256sum -c - && \
    tar -xzf "trivy_${TRIVY_VERSION}_Linux-${TRIVY_ARCH}.tar.gz" trivy && \
    mv trivy /usr/local/bin/trivy && \
    chmod +x /usr/local/bin/trivy && \
    rm -f /tmp/trivy_${TRIVY_VERSION}_* && \
    apk del curl

# SemgrepScanner (Fase 4 — SAST) precisa do binário semgrep, também só na
# imagem do worker. Ao contrário do trivy, o Semgrep não publica um
# tarball standalone com checksum próprio — é distribuído via PyPI (wheel
# manylinux/musllinux) — então a garantia de integridade aqui é a cadeia
# de confiança padrão do pip contra o índice do PyPI (TLS + hash por
# arquivo verificado pelo próprio pip), não uma verificação de checksum
# explícita como a do trivy acima; documentado aqui como uma diferença
# real, não uma omissão. Instalado numa venv isolada (o Python do sistema
# Alpine é "externally managed" desde a 3.11 — apio pip direto falharia)
# e exposto via symlink no PATH, igual ao trivy.
ARG SEMGREP_VERSION=1.174.0
RUN apk add --no-cache python3 py3-pip && \
    python3 -m venv /opt/semgrep-venv && \
    /opt/semgrep-venv/bin/pip install --no-cache-dir --disable-pip-version-check "semgrep==${SEMGREP_VERSION}" && \
    ln -s /opt/semgrep-venv/bin/semgrep /usr/local/bin/semgrep && \
    addgroup -S nix && adduser -S nix -G nix
USER nix
WORKDIR /app
COPY --from=builder --chown=nix:nix /out/worker ./worker

ENTRYPOINT ["./worker"]
